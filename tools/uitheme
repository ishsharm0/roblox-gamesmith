def chromium():
    c = sorted(glob.glob(os.path.expanduser("~/Library/Caches/ms-playwright/chromium_headless_shell-*/*/*headless*shell*")))
    c += sorted(glob.glob(os.path.expanduser("~/.cache/ms-playwright/chromium_headless_shell-*/*/*headless*shell*")))
    c = [p for p in c if os.access(p, os.X_OK) and os.path.isfile(p)]
    for p in ("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome", "/usr/bin/chromium", "/usr/bin/google-chrome"):
        if os.path.exists(p):
            c.append(p)
    if not c:
        sys.exit("no Chromium found: `npx playwright install chromium-headless-shell` or install Chrome")
    return c[0]


def css_vars(t):
    c, s, ty = t["color"], t["shape"], t["type"]
    v = {f"--{k}": val for k, val in c.items()}
    v.update({"--radius": f'{s["radius"]}px', "--bradius": f'{s["buttonRadius"]}px', "--stroke": f'{s["stroke"]}px',
              "--lip": f'{s["lip"]}px', "--shadow": f'{s["shadow"]}px', "--shadowA": s["shadowAlpha"],
              "--grad": s["gradient"], "--tstroke": f'{ty["textStroke"]}px',
              "--display": f"'{FONTS[ty['display']]}'", "--body": f"'{FONTS[ty['body']]}'",
              "--bodyW": ty["bodyWeight"], "--btnfont": f"'{FONTS[ty.get('button', ty['display'])]}'", "--displayW": ty.get("displayWeight", 400),
              "--case": "uppercase" if ty["titleCase"] == "upper" else "none",
              "--glow": f'0 0 {s.get("glow", 0)}px {c["outline"]}' if s.get("glow") else "0 0 0 transparent"})
    for r in RARITY:
        v[f"--r-{r}"] = t["rarity"][r]
    return ";".join(f"{k}:{val}" for k, val in v.items())


