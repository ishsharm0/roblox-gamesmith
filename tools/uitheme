def sheet(themes, out, only=None):
    out = Path(out); out.mkdir(parents=True, exist_ok=True)
    fams = sorted({FONTS[t["type"][k]] for t in themes for k in ("display", "body")})
    link = "https://fonts.googleapis.com/css2?" + "&".join("family=" + f.replace(" ", "+") + (":wght@400;600;700;800;900" if f in ("Nunito", "Montserrat", "Nunito Sans", "Oswald", "Merriweather", "Roboto", "Ubuntu", "Josefin Sans", "Grenze Gotisch") else "") for f in fams) + "&display=block"
    exe = chromium(); made = []
    for t in themes:
        if only and t["name"].lower() != only.lower():
            continue
        html = (f'<!doctype html><meta charset="utf-8"><link rel="stylesheet" href="{link}">'
                '<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css">'
                '<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css">'
                f'<style>{CSS}</style><body>{screen_html(t)}</body>')
        with tempfile.NamedTemporaryFile("w", suffix=".html", delete=False) as f:
            f.write(html)
        png = out / f'{t["name"].lower().replace(" ", "-")}.png'
        subprocess.run([exe, "--headless", "--disable-gpu", "--hide-scrollbars", "--force-device-scale-factor=2", "--virtual-time-budget=6000",
                        "--window-size=844,1198", f"--screenshot={png}", "file://" + f.name], capture_output=True, timeout=120)
        os.unlink(f.name)
        made.append(str(png)); print(png)
    return made


def luau(themes):
    def col(h):
        h = h.lstrip("#"); return f"Color3.fromRGB({int(h[0:2], 16)}, {int(h[2:4], 16)}, {int(h[4:6], 16)})"
    o = ["--!strict", "-- Generated by tools/uitheme from ui-themes.json. Edit the JSON, look at the sheet, regenerate.", "local Themes = {}", ""]
    for t in themes:
        o.append(f'Themes["{t["name"]}"] = {{')
        o.append("\tcolor = {")
        for k, v in t["color"].items():
            o.append(f"\t\t{k} = {v if not isinstance(v, str) else col(v)},")
        o.append("\t},\n\trarity = {")
        for k in RARITY:
            o.append(f"\t\t{k} = {col(t['rarity'][k])},")
        o.append("\t},\n\tshape = {")
        for k, v in t["shape"].items():
            o.append(f"\t\t{k} = {json.dumps(v)},")
        ty = t["type"]
        o.append("\t},\n\ttype = {")
        o.append(f'\t\tdisplay = Font.new("rbxasset://fonts/families/{ty["display"]}.json", Enum.FontWeight.{"Bold" if ty.get("displayWeight", 400) >= 600 else "Regular"}),')
        w = {600: "SemiBold", 700: "Bold", 800: "ExtraBold", 900: "Heavy"}[ty["bodyWeight"]]
        o.append(f'\t\tbody = Font.new("rbxasset://fonts/families/{ty["body"]}.json", Enum.FontWeight.{w}),')
        o.append(f'\t\tbutton = Font.new("rbxasset://fonts/families/{ty.get("button", ty["display"])}.json", Enum.FontWeight.Bold),')
        o.append(f'\t\ttitleUpper = {"true" if ty["titleCase"] == "upper" else "false"},')
        o.append(f'\t\ttextStroke = {ty["textStroke"]},')
        o.append("\t},\n\tmotion = {")
        for k, v in t["motion"].items():
            o.append(f"\t\t{k} = {json.dumps(v)},")
        o.append("\t},\n}\n")
    o.append("return Themes\n")
    return "\n".join(o)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", choices=["sheet", "luau", "new"])
    ap.add_argument("args", nargs="*")
    ap.add_argument("--only"); ap.add_argument("--out"); ap.add_argument("--from", dest="src")
    a = ap.parse_args()
    files = [x for x in a.args if x.endswith(".json")]
    path = Path(files[0]) if files else DEFAULT
    themes = json.loads(path.read_text())
    if a.cmd == "sheet":
        sheet(themes, a.out or "ui-sheets", a.only)
    elif a.cmd == "luau":
        text = luau(themes)
        Path(a.out).write_text(text) if a.out else sys.stdout.write(text)
    else:
        name = [x for x in a.args if not x.endswith(".json")][0]
        src = next(t for t in themes if t["name"].lower() == (a.src or themes[0]["name"]).lower())
        themes.append(dict(json.loads(json.dumps(src)), name=name))
        path.write_text(json.dumps(themes, indent=1) + "\n")
        print(f"added {name} (copy of {src['name']}) to {path}")


if __name__ == "__main__":
    main()
