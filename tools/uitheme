    ts = " ts" if t["type"]["textStroke"] else ""
    hud = f'''
<div class="pill" style="left:16px;top:12px;width:148px"><div class="coin"><i class="ph-fill ph-coin"></i></div><span class="{ts.strip()}" style="flex:1;text-align:center">12.4K</span></div>
