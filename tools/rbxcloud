#!/usr/bin/env python3
"""Open Cloud assets: info | get ID | operation PATH | upload FILE --name NAME [--upload] [--wait].

Upload previews its manifest unless --upload is supplied. Credentials remain in an environment
variable ROBLOX_OPEN_CLOUD_KEY or ~/.config/roblox/open-cloud.key (mode 0600). Never in argv.
"""
import argparse
import json
import os
from pathlib import Path
import re
import secrets
import sys
import time
import urllib.request
import urllib.error

BASE = 'https://apis.roblox.com/assets/v1/'
CONFIG = Path.home()/'.config/roblox'
FORMATS = {'.fbx':('Model','model/fbx'), '.glb':('Model','model/gltf-binary'),
           '.gltf':('Model','model/gltf+json'), '.rbxm':('Model','model/x-rbxm'),
           '.rbxmx':('Model','model/x-rbxm'), '.wav':('Audio','audio/wav'),
           '.ogg':('Audio','audio/ogg'), '.mp3':('Audio','audio/mpeg'),
           '.flac':('Audio','audio/flac'), '.png':('Image','image/png'),
           '.jpg':('Image','image/jpeg'), '.jpeg':('Image','image/jpeg')}

def key():
    value=os.environ.get('ROBLOX_OPEN_CLOUD_KEY')
    if not value:
        p=Path(os.environ.get('ROBLOX_OPEN_CLOUD_KEY_FILE',CONFIG/'open-cloud.key'))
        if p.stat().st_mode & 0o077:
            raise ValueError(f'Credential file must be private: chmod 600 {p}')
        value=p.read_text().strip()
    if not value: raise ValueError('Open Cloud key is empty')
    return value

def request(url, data=None, content_type=None):
    credential=key()
    headers={'x-api-key':credential}
    if content_type: headers['Content-Type']=content_type
    req=urllib.request.Request(url,data=data,headers=headers)
    try:
        with urllib.request.urlopen(req,timeout=30) as response:
            return json.load(response)
    except urllib.error.HTTPError as e:
        body=e.read().decode(errors='replace').replace(credential,'[redacted]')
        raise ValueError(f'Open Cloud HTTP {e.code}: {body[:1000]}') from None

def manifest(path, name, description, creator, group):
    path=Path(path)
    if path.suffix.lower() not in FORMATS: raise ValueError('Unsupported format; use GLB/FBX/RBXM, audio or image')
    if not 0<path.stat().st_size<=20*1024*1024: raise ValueError('Assets must be nonempty and at most 20 MB')
    if not re.fullmatch(r'[1-9][0-9]*',str(creator)): raise ValueError('Creator must be a numeric user/group id')
    if not name.strip(): raise ValueError('Asset name is required')
    asset_type,mime=FORMATS[path.suffix.lower()]
    return {'assetType':asset_type,'displayName':name,'description':description,
            'creationContext':{'creator':{'groupId' if group else 'userId':str(creator)},'expectedPrice':0}},mime

def multipart(path, payload, mime):
    boundary='RobloxAsset'+secrets.token_hex(16)
    name=Path(path).name.replace('"','_').replace('\r','_').replace('\n','_')
    data=(f'--{boundary}\r\nContent-Disposition: form-data; name="request"\r\n'
          'Content-Type: application/json\r\n\r\n').encode()+json.dumps(payload).encode()
    data+=(f'\r\n--{boundary}\r\nContent-Disposition: form-data; name="fileContent"; filename="{name}"\r\n'
           f'Content-Type: {mime}\r\n\r\n').encode()+Path(path).read_bytes()
    data+=f'\r\n--{boundary}--\r\n'.encode()
    return data,'multipart/form-data; boundary='+boundary

def operation_path(value):
    value=value.removeprefix(BASE).removeprefix('operations/')
    if not re.fullmatch(r'[A-Za-z0-9_-]+',value): raise ValueError('Invalid operation id')
    return 'operations/'+value

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    sub=parser.add_subparsers(dest='cmd',required=True)
    sub.add_parser('info')
    get=sub.add_parser('get');get.add_argument('id',type=int)
    op=sub.add_parser('operation');op.add_argument('path')
    up=sub.add_parser('upload');up.add_argument('file');up.add_argument('--name',required=True)
    up.add_argument('--description',default='');up.add_argument('--creator');up.add_argument('--group',action='store_true')
    up.add_argument('--upload',action='store_true');up.add_argument('--wait',action='store_true')
    up.add_argument('--out',help='Save operation/asset response JSON for resuming without uploading again')
    a=parser.parse_args()
    if a.cmd=='info':
        result=request('https://apis.roblox.com/api-keys/v1/introspect',json.dumps({'apiKey':key()}).encode(),'application/json')
        result={k:result.get(k) for k in ('authorizedUserId','enabled','expired','expirationTimeUtc','scopes')}
    elif a.cmd=='get':result=request(BASE+'assets/'+str(a.id))
    elif a.cmd=='operation':result=request(BASE+operation_path(a.path))
    else:
        creator=a.creator
        if not creator:
            creator=json.loads((CONFIG/'creator.json').read_text())['userId']
        payload,mime=manifest(a.file,a.name,a.description,creator,a.group)
        if not a.upload:
            print(json.dumps({'preview':True,'file':str(Path(a.file).resolve()),'request':payload,'contentType':mime},indent=2))
            return
        data,content_type=multipart(a.file,payload,mime)
        result=request(BASE+'assets',data,content_type)
        if a.out: Path(a.out).write_text(json.dumps(result,indent=2)+'\n')
        if a.wait and result.get('path','').startswith('operations/'):
            operation=result['path']
            deadline=time.monotonic()+120
            while not result.get('done') and time.monotonic()<deadline:
                time.sleep(2)
                result=request(BASE+operation_path(operation))
            if not result.get('done'):
                print(json.dumps(result,indent=2));raise ValueError('Operation still pending; resume with operation '+operation)
    print(json.dumps(result,indent=2))
    if getattr(a,'out',None): Path(a.out).write_text(json.dumps(result,indent=2)+'\n')
    if result.get('error'): raise ValueError('Asset operation failed; see operation response above')

if __name__=='__main__':
    try:main()
    except (ValueError,OSError,KeyError) as e:sys.exit(str(e))
