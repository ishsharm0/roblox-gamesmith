#!/usr/bin/env python3
"""Talk to Roblox Studio's built-in MCP server from the shell.

  studio tools                         list the tools and their arguments
  studio list                          connected Studio windows (studio_id, name, place id)
  studio call <tool> '<json args>'     call any tool; images are saved, text is printed
  studio luau <file.luau|-> [--ctx Edit|Server|Client]   run Luau (Server/Client while playtesting)
  studio shot [out.png] [--pos x,y,z --look x,y,z]       capture the viewport, optionally from a camera
  studio schema <tool>                 one tool's full input schema
  studio state | play | stop | console
  studio open <place.rbxl|.rbxlx>      open a local place file in a new Studio window and wait for it
  studio burst out.mp4 [--seconds 20]  a film made of viewport captures (a few fps) during a playtest: works
                                       wherever Studio runs; use it for reviews of camera, HUD and pacing
  studio record out.mp4 [--seconds 20] [--title <text in the window title>]   (STUDIO_REMOTE only) film the
                                       Studio window on the PC with sound-free screen capture; start a
                                       playtest first. For watching game feel, pacing and trailers.
  studio export <game.Path> <out.rbxm> serialize an instance (a map, a model) to a model file on disk
  studio import <in.rbxm> [game.Path]  load a model file into the open place (default parent: Workspace)

Studio must be running with a place open and "Enable Studio as MCP server" on (Assistant -> ... ->
Manage MCP Servers). With several Studio windows open, pass --studio <id or name> to make that one
active; otherwise Studio's active one is used. Every call starts StudioMCP over stdio, so no Claude Code restart is
needed after Studio starts.

Studio on another machine: set STUDIO_REMOTE=user@host (a Windows PC reachable over SSH with key auth,
signed in to Studio, MCP server enabled there). Every command then drives that Studio instead of a local
one; `studio open` copies the place file over and opens it on that machine's desktop. Use it to keep
playtests off the computer someone is working on.
"""
import base64, json, os, subprocess, sys, time, selectors
from pathlib import Path

BIN = "/Applications/RobloxStudio.app/Contents/MacOS/StudioMCP"
APP = "/Applications/RobloxStudio.app/Contents/MacOS/RobloxStudio"
B64 = Path(__file__).resolve().parent.joinpath("luau", "b64.luau").read_text()
REMOTE = os.environ.get("STUDIO_REMOTE", "").strip()
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=20"]
CHUNK = 60_000   # characters of base64 per execute_luau round trip (its text result is cut at ~100k)


class MCP:
    def __init__(self):
        if REMOTE:
            probe = subprocess.run(SSH + [REMOTE, "echo up"], capture_output=True, text=True)
            if probe.stdout.strip() != "up":
                raise SystemExit(f"The Studio machine ({REMOTE}) is unreachable over SSH: it is off, asleep or off the "
                                 "network. Wake it (a wake-on-LAN tool if you have one) or ask the person; do not "
                                 "fall back to opening Studio on this computer.")
        cmd = SSH + [REMOTE, 'cmd /c "%LOCALAPPDATA%\\Roblox\\mcp.bat"'] if REMOTE else [BIN]
        self.p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL, bufsize=0)
        self.n = 0
        self.req("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                "clientInfo": {"name": "studio-cli", "version": "1.0"}})
        self.send({"jsonrpc": "2.0", "method": "notifications/initialized"})

    def send(self, msg):
        self.p.stdin.write((json.dumps(msg) + "\n").encode())
        self.p.stdin.flush()

    def req(self, method, params, timeout=600):
        self.n += 1
        my = self.n
        self.send({"jsonrpc": "2.0", "id": my, "method": method, "params": params})
        t0 = time.time()
        selector = selectors.DefaultSelector()
        selector.register(self.p.stdout, selectors.EVENT_READ)
        while time.time() - t0 < timeout:
            if not selector.select(max(0, timeout - (time.time() - t0))):
                break
            line = self.p.stdout.readline()
            if not line:
                raise SystemExit("StudioMCP closed the connection (is Studio running with a place open?)")
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if msg.get("id") == my:
                if "error" in msg:
                    raise SystemExit(f"error: {msg['error'].get('message', msg['error'])}")
                return msg["result"]
        raise SystemExit(f"timed out after {timeout}s waiting for {method}")

    def close(self):
        try:
            self.p.stdin.close(); self.p.terminate()
            self.p.wait(timeout=3)
        except Exception:
            pass


def remote_ps(script, timeout=120):
    """Run a PowerShell script on the remote PC (EncodedCommand avoids every quoting layer)."""
    enc = base64.b64encode(script.encode("utf-16le")).decode()
    r = subprocess.run(SSH + [REMOTE, "powershell -NoProfile -NonInteractive -EncodedCommand " + enc],
                       capture_output=True, text=True, timeout=timeout)
    if r.returncode:
        err = "\n".join(l for l in r.stderr.splitlines() if "CLIXML" not in l and "<Objs" not in l)
        raise SystemExit("remote PowerShell failed:\n" + r.stdout[-1500:] + err[-1500:])
    return r.stdout


def remote_open(place):
    """Copy the place to the PC and open it in Studio on the signed-in desktop. A process started
    straight from SSH has no desktop, so an interactive scheduled task does the launch."""
    name = os.path.basename(place)
    remote_ps('New-Item -ItemType Directory -Force "$env:USERPROFILE\\rbx-remote" | Out-Null')
    subprocess.run(["scp", "-q", "-o", "BatchMode=yes", place, f"{REMOTE}:rbx-remote/{name}"], check=True)
    remote_ps(f'''
$dir = "$env:USERPROFILE\\rbx-remote"
$exe = (Get-Process RobloxStudioBeta -ErrorAction SilentlyContinue | Select-Object -First 1).Path
if (-not $exe) {{   # the registry's ContentFolder can point at a removed version: look for the newest real exe
  $exe = Get-ChildItem "$env:LOCALAPPDATA\\Roblox\\Versions" -Recurse -Filter RobloxStudioBeta.exe -ErrorAction SilentlyContinue |
    Sort-Object LastWriteTime -Descending | Select-Object -First 1 -ExpandProperty FullName
}}
if (-not $exe -or -not (Test-Path $exe)) {{ Write-Output "Roblox Studio is not installed on the remote machine"; exit 1 }}
Set-Content -Path "$dir\\open.bat" -Encoding ASCII -Value "@echo off`r`nstart `"`" `"$exe`" -task EditFile -localPlaceFile `"$dir\\{name}`""
schtasks /create /tn StudioRemoteOpen /tr "$dir\\open.bat" /sc once /st 00:00 /it /f | Out-Null
schtasks /run /tn StudioRemoteOpen | Out-Null
''')


def remote_record(out, seconds, title):
    tag = f"{os.getpid()}-{int(time.time())}"
    """Film the Studio window on the PC. The capture has to run on the signed-in desktop, so a small
    script is run by an interactive scheduled task: it finds the window, brings it forward, and lets
    ffmpeg film the screen (Desktop Duplication: a window grab comes out black for a GPU view). The MP4 is then copied back."""
    remote_ps(f'''
$dir = "$env:USERPROFILE\\rbx-remote"
New-Item -ItemType Directory -Force $dir | Out-Null
Remove-Item "$dir\\rec-{tag}.mp4","$dir\\rec-{tag}.log","$dir\\rec-{tag}.done" -ErrorAction SilentlyContinue
$script = @"
`$p = Get-Process RobloxStudioBeta | Where-Object {{ `$_.MainWindowTitle -like '*{title}*' }} | Select-Object -First 1
if (-not `$p) {{ 'no Studio window with that title' | Set-Content '$dir\\rec-{tag}.log'; 'x' | Set-Content '$dir\\rec-{tag}.done'; exit }}
Add-Type -Namespace W -Name U -MemberDefinition '[DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr h, int n); [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr h); [DllImport("user32.dll")] public static extern void keybd_event(byte k, byte s, uint f, UIntPtr e);'
[W.U]::keybd_event(0x12, 0, 0, [UIntPtr]::Zero); [W.U]::keybd_event(0x12, 0, 2, [UIntPtr]::Zero)
[W.U]::ShowWindow(`$p.MainWindowHandle, 3) | Out-Null
[W.U]::SetForegroundWindow(`$p.MainWindowHandle) | Out-Null
Start-Sleep -Milliseconds 900
& ffmpeg -y -hide_banner -loglevel error -f lavfi -i "ddagrab=framerate=30:output_idx=0,hwdownload,format=bgra" -t {seconds} -vf "scale=1280:-2" -c:v libx264 -preset veryfast -crf 24 -pix_fmt yuv420p '$dir\\rec-{tag}.mp4' 2> '$dir\\rec-{tag}.log'
if (-not (Test-Path '$dir\\rec-{tag}.mp4') -or (Get-Item '$dir\\rec-{tag}.mp4').Length -lt 20000) {{
  & ffmpeg -y -hide_banner -loglevel error -f gdigrab -framerate 30 -t {seconds} -i desktop -vf "scale=1280:-2" -c:v libx264 -preset veryfast -crf 24 -pix_fmt yuv420p '$dir\\rec-{tag}.mp4' 2>> '$dir\\rec-{tag}.log'
}}
'x' | Set-Content '$dir\\rec-{tag}.done'
"@
Set-Content -Path "$dir\\rec-{tag}.ps1" -Value $script -Encoding UTF8
Set-Content -Path "$dir\\rec-{tag}.bat" -Encoding ASCII -Value "@echo off`r`npowershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File `"$dir\\rec-{tag}.ps1`""
schtasks /create /tn StudioRecord-{tag} /tr "$dir\\rec-{tag}.bat" /sc once /st 00:00 /it /f | Out-Null
schtasks /run /tn StudioRecord-{tag} | Out-Null
$t = 0
while (-not (Test-Path "$dir\\rec-{tag}.done") -and $t -lt {seconds + 60}) {{ Start-Sleep 1; $t++ }}
if (Test-Path "$dir\\rec-{tag}.log") {{ Get-Content "$dir\\rec-{tag}.log" }}
schtasks /delete /tn StudioRecord-{tag} /f | Out-Null
Remove-Item "$dir\\rec-{tag}.ps1","$dir\\rec-{tag}.bat","$dir\\rec-{tag}.done","$dir\\rec-{tag}.log" -ErrorAction SilentlyContinue
exit 0   # success is judged by the file that comes back, not by schtasks' exit codes
''', timeout=seconds + 120)
    r = subprocess.run(["scp", "-q", "-o", "BatchMode=yes", f"{REMOTE}:rbx-remote/rec-{tag}.mp4", out])
    if r.returncode or not os.path.exists(out) or os.path.getsize(out) < 20000:
        raise SystemExit("recording failed. Either no Studio window has that title, or the PC's desktop has no live "
                         "display: a signed-in but disconnected remote-desktop session cannot be filmed (stills "
                         "still work). Run wake-pc (it attaches the session to the PC's screen) and record again.")
    print(f"recorded {seconds}s -> {os.path.abspath(out)}")


def raise_(e):
    raise e


def hide_studio():
    if REMOTE:
        return
    subprocess.run(["osascript", "-e", 'tell application "System Events" to set visible of '
                    '(every process whose name contains "RobloxStudio") to false'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def studios(m, wait=12):
    # Studio dials the StudioMCP process we just started and retries every ~3 s, so the first
    # answers can be empty; keep asking for a few seconds before saying nothing is connected.
    t0 = time.time()
    while True:
        r = m.req("tools/call", {"name": "list_roblox_studios", "arguments": {}})
        txt = "\n".join(c.get("text", "") for c in r.get("content", []) if c.get("type") == "text")
        if '"studios":[]' not in txt.replace(" ", "") or time.time() - t0 > wait:
            return txt
        time.sleep(1)


def pick_studio(m, want):
    def sid(it):
        return str(it.get("studio_id") or it.get("id") or it.get("instance_id") or it.get("studioId"))
    def listing():
        txt = studios(m)
        try:
            data = json.loads(txt)
        except ValueError:
            data = None
        if isinstance(data, dict):
            data = data.get("studios") or data.get("instances") or list(data.values())[0]
        return txt, (data if isinstance(data, list) else [])
    # Windows register one by one over a few seconds, so the wanted one can be missing from the
    # first listing even though it is open. Ask again before refusing.
    t0 = time.time()
    while True:
        txt, items = listing()
        if not want or time.time() - t0 > 15:
            break
        for it in items:
            if want in (sid(it), str(it.get("name")), str(it.get("place_id") or it.get("placeId"))):
                return sid(it)
        time.sleep(1.5)
    if not items:
        raise SystemExit("no Studio connected:\n" + txt)
    if want:
        raise SystemExit(f"Studio {want!r} is not connected; refusing to select another window.\n" + txt)
    if len(items) > 1:   # several windows (the start page counts): take the first with a place open
        for it in items:
            r = m.req("tools/call", {"name": "get_studio_state", "arguments": {"studio_id": sid(it)}})
            body = " ".join(c.get("text", "") for c in r.get("content", []))
            if not r.get("isError") and "not open" not in body.lower():
                return sid(it)
    return sid(items[0])


def show(result, out=None):
    k = 0
    for c in result.get("content", []):
        if c.get("type") == "text":
            print(c["text"])
        elif c.get("type") == "image":
            path = out if (out and k == 0) else (out or "studio-shot.png").replace(".png", f"-{k}.png")
            with open(path, "wb") as f:
                f.write(base64.b64decode(c["data"]))
            print(f"image saved: {os.path.abspath(path)}")
            k += 1
    if result.get("isError"):
        sys.exit(1)


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__); return
    want = None
    if "--studio" in a:   # accepted anywhere on the line
        i = a.index("--studio"); want = a[i + 1]; del a[i:i + 2]
    cmd = a[0]
    # read piped code before any ssh child starts: ssh would swallow our stdin and the script would run empty
    piped = sys.stdin.read() if cmd == "luau" and len(a) > 1 and a[1] == "-" else None
    if cmd == "record":
        if not REMOTE:
            raise SystemExit("studio record needs STUDIO_REMOTE (it films the Studio window on that PC)")
        out = next((x for x in a[1:] if x.endswith(".mp4")), "studio-record.mp4")
        secs = int(a[a.index("--seconds") + 1]) if "--seconds" in a else 20
        title = a[a.index("--title") + 1] if "--title" in a else (want or "Roblox Studio")
        remote_record(out, secs, os.path.splitext(title)[0])
        return
    if cmd == "open":
        place = os.path.abspath(a[1])
        # -g: don't bring Studio to the front; -j: launch hidden. The person is using this Mac, so Studio
        # must never pop over their windows; it is hidden again once it reports the place open.
        if REMOTE:
            remote_open(place)
        else:
            subprocess.run(["open", "-g", "-j", "-n", "/Applications/RobloxStudio.app", "--args",
                            "-task", "EditFile", "-localPlaceFile", place], check=True)
        t0 = time.time()
        while time.time() - t0 < 180:
            time.sleep(5)
            m = MCP()
            try:
                txt = studios(m, wait=6)
                for it in json.loads(txt).get("studios", []):
                    r = m.req("tools/call", {"name": "get_studio_state", "arguments": {"studio_id": it["id"]}})
                    body = " ".join(c.get("text", "") for c in r.get("content", []))
                    if not r.get("isError") and "not open" not in body.lower():
                        if it.get('name') not in (os.path.basename(place), Path(place).stem):
                            continue
                        hide_studio()
                        print(f"open: {place} (studio {it['id']})"); return
            except (SystemExit, ValueError):
                pass
            finally:
                m.close()
        raise SystemExit("Studio did not report an open place within 3 minutes")
    m = MCP()
    try:
        if cmd == "tools":
            r = m.req("tools/list", {})
            for t in r["tools"]:
                props = t.get("inputSchema", {}).get("properties", {})
                req = set(t.get("inputSchema", {}).get("required", []))
                args = ", ".join((p + ("*" if p in req else "")) for p in props)
                print(f"{t['name']}({args})\n    {(t.get('description') or '').splitlines()[0][:200]}")
            return
        if cmd == "schema":
            r = m.req("tools/list", {})
            for t in r["tools"]:
                if t["name"] == a[1]:
                    print(json.dumps(t, indent=1))
            return
        if cmd == "list":
            print(studios(m)); return
        schema = {t["name"]: t.get("inputSchema", {}).get("properties", {}) for t in m.req("tools/list", {})["tools"]}
        sid = None
        if want or any("studio_id" in v for v in schema.values()):
            sid = pick_studio(m, want)
        if want and "set_active_studio" in schema:
            show(m.req("tools/call", {"name": "set_active_studio", "arguments": {"studio_id": sid}}))
        def call(name, args, out=None):
            args = dict(args)
            if sid and "studio_id" in schema.get(name, {}):   # newer Studio builds want it on every call
                args["studio_id"] = sid
            show(m.req("tools/call", {"name": name, "arguments": args}), out)
        if cmd == "call":
            call(a[1], json.loads(a[2]) if len(a) > 2 else {})
        elif cmd == "luau":
            ctx = "Edit"
            if "--ctx" in a:
                i = a.index("--ctx"); ctx = a[i + 1]; del a[i:i + 2]
            src = piped if piped is not None else open(a[1]).read()
            args = {"code": src}
            if "datamodel_type" in schema.get("execute_luau", {}):
                args["datamodel_type"] = ctx
            call("execute_luau", args)
        elif cmd == "burst":
            # A film made of viewport captures over one MCP session: works on any machine and any display state
            # (unlike screen recording), shows the real camera, HUD and motion at a few frames a second.
            import tempfile
            out = next((x for x in a[1:] if x.endswith(".mp4")), None) or raise_(SystemExit("burst needs an out.mp4"))
            secs = float(a[a.index("--seconds") + 1]) if "--seconds" in a else 20
            tmp = tempfile.mkdtemp(prefix="burst-")
            t0, n = time.time(), 0
            while time.time() - t0 < secs:
                r = m.req("tools/call", {"name": "screen_capture", "arguments": dict(
                    {"capture_id": f"Burst_{int(time.time() * 1000)}"}, **({"studio_id": sid} if sid else {}))}, timeout=30)
                img = next((c for c in r.get("content", []) if c.get("type") == "image"), None)
                if img:
                    n += 1
                    open(os.path.join(tmp, f"f{n:05d}.jpg"), "wb").write(base64.b64decode(img["data"]))
            if n < 3:
                raise SystemExit("burst captured fewer than 3 frames")
            fps = max(1.0, n / (time.time() - t0))
            subprocess.run(["ffmpeg", "-v", "error", "-y", "-framerate", f"{fps:.2f}", "-i", os.path.join(tmp, "f%05d.jpg"),
                            "-vf", "scale=trunc(iw/2)*2:trunc(ih/2)*2", "-c:v", "libx264", "-pix_fmt", "yuv420p",
                            "-r", "30", out], check=True)
            print(f"burst: {n} frames in {secs:.0f}s ({fps:.1f} fps) -> {os.path.abspath(out)}")
        elif cmd == "shot":
            out = next((x for x in a[1:] if x.lower().endswith((".png", ".jpg", ".jpeg"))), None)
            if not out and len(a) > 1 and not a[1].startswith("--"):
                raise SystemExit(f"shot: the output must end in .png or .jpg (got {a[1]!r})")
            out = out or "studio-shot.png"
            args = {"capture_id": "ScreenCapture_" + str(int(time.time() * 1000))}
            if "--pos" in a:
                args["camera_position"] = [float(x) for x in a[a.index("--pos") + 1].split(",")]
                look = a[a.index("--look") + 1] if "--look" in a else "0,0,0"
                args["look_at_position"] = [float(x) for x in look.split(",")]
            call("screen_capture", args, out)
        elif cmd in ("export", "import"):
            ctx = {"datamodel_type": "Edit"} if "datamodel_type" in schema.get("execute_luau", {}) else {}
            def luau(code):
                r = m.req("tools/call", {"name": "execute_luau", "arguments": dict(ctx, code=code, **({"studio_id": sid} if sid else {}))})
                txt = "".join(c.get("text", "") for c in r.get("content", []) if c.get("type") == "text")
                if r.get("isError"):
                    raise SystemExit(txt)
                return txt
            if cmd == "export":
                path, out = a[1], a[2]
                n = int(luau(B64 + f"""
local inst = {path}
local data = encode(game:GetService("SerializationService"):SerializeInstancesAsync({{inst}}))
shared.__studio_cli_export = data
return tostring(#data)""").strip().split()[-1])
                parts = []
                for i in range(0, n, CHUNK):
                    parts.append(luau(f"return string.sub(shared.__studio_cli_export, {i + 1}, {min(n, i + CHUNK)})").strip())
                luau("shared.__studio_cli_export = nil return 'ok'")
                raw = base64.b64decode("".join(parts))
                with open(out, "wb") as f:
                    f.write(raw)
                print(f"exported {path} -> {os.path.abspath(out)} ({len(raw):,} bytes)")
            else:
                src, parent = a[1], (a[2] if len(a) > 2 else "workspace")
                data = base64.b64encode(open(src, "rb").read()).decode()
                luau("shared.__studio_cli_import = {} return 'ok'")
                for i in range(0, len(data), CHUNK):
                    luau(f"table.insert(shared.__studio_cli_import, [[{data[i:i + CHUNK]}]]) return 'ok'")
                print(luau(B64 + f"""
local buf = decode(table.concat(shared.__studio_cli_import))
shared.__studio_cli_import = nil
local CHS = game:GetService("ChangeHistoryService")
local rec = CHS:TryBeginRecording("studio import")
local list = game:GetService("SerializationService"):DeserializeInstancesAsync(buf)
for _, inst in list do inst.Parent = {parent} end
if rec then CHS:FinishRecording(rec, Enum.FinishRecordingOperation.Commit) end
local names = {{}}
for _, inst in list do table.insert(names, inst:GetFullName()) end
return "imported " .. table.concat(names, ", ")""").strip())
        elif cmd == "state":
            call("get_studio_state", {})
        elif cmd in ("play", "stop"):
            call("start_stop_play", {"is_start": cmd == "play"})
            hide_studio()   # entering or leaving play mode can surface the window
        elif cmd == "console":
            call("get_console_output", {})
        else:
            raise SystemExit(f"unknown command {cmd}; see studio --help")
    finally:
        hide_studio()
        m.close()


if __name__ == "__main__":
    main()
