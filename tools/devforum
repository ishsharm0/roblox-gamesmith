#!/usr/bin/env python3
"""devforum: search the Roblox Developer Forum (Discourse public JSON API, no login).

Commands:
  search "<query>" [-n 10] [--solved] [--title]   topics ranked by Discourse relevance, with links
  read <topicId|url> [--replies 3]      first post, accepted answer, and top-liked replies as text

Tips: put API names in the query (e.g. "ProfileStore session lock", "PathfindingService
agent radius"); add --solved for questions with an accepted answer. Responses are cached
for 30 minutes in ~/.cache/roblox-gamesmith/research.
"""

import argparse
import html
import os
import re
import sys
import urllib.parse

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _common import HttpError, clip, fmt_age, days_since, http_json  # noqa: E402

BASE = "https://devforum.roblox.com"


def html_to_text(s):
    s = re.sub(r"(?is)<(script|style)[^>]*>.*?</\1>", "", s or "")
    s = re.sub(r"(?is)<aside[^>]*class=\"[^\"]*onebox[^\"]*\"[^>]*>.*?</aside>", "[link preview]\n", s)
    s = re.sub(r"(?is)<pre[^>]*>\s*<code[^>]*>(.*?)</code>\s*</pre>", lambda m: "\n```\n" + m.group(1) + "\n```\n", s)
    s = re.sub(r"(?is)<a [^>]*href=\"#[^\"]*\"[^>]*>\s*</a>", "", s)  # heading anchors
    s = re.sub(r"(?is)<code[^>]*>(.*?)</code>", r"`\1`", s)
    s = re.sub(r"(?is)<a [^>]*href=\"([^\"]+)\"[^>]*>(.*?)</a>",
               lambda m: m.group(2) if m.group(1) in m.group(2) else f"{m.group(2)} ({m.group(1)})", s)
    s = re.sub(r"(?is)<img [^>]*alt=\"([^\"]*)\"[^>]*>", r"[image: \1]", s)
    s = re.sub(r"(?i)<br\s*/?>", "\n", s)
    s = re.sub(r"(?i)</(p|div|h[1-6]|li|blockquote|tr)>", "\n", s)
    s = re.sub(r"(?i)<li[^>]*>", "- ", s)
    s = re.sub(r"<[^>]+>", "", s)
    s = html.unescape(s)
    s = re.sub(r"[ \t]+\n", "\n", s)
    return re.sub(r"\n{3,}", "\n\n", s).strip()


def cmd_search(args):
    q = args.query + (" status:solved" if args.solved else "") + (" in:title" if args.title else "")
    d = http_json(f"{BASE}/search.json?" + urllib.parse.urlencode({"q": q}), ttl=1800, namespace="devforum")
    cats = {c["id"]: c.get("name") for c in d.get("categories", [])}
    blurbs = {}
    for p in d.get("posts", []):
        blurbs.setdefault(p["topic_id"], html.unescape(p.get("blurb") or ""))
    topics = d.get("topics", [])[: args.n]
    if not topics:
        print("no results")
        return
    print(f"# devforum '{q}': {len(topics)} topics")
    for i, t in enumerate(topics, 1):
        flags = []
        if t.get("has_accepted_answer"):
            flags.append("SOLVED")
        cat = cats.get(t.get("category_id"))
        print(f"{i:>2}. {clip(t.get('title'), 90)}")
        print("    " + " | ".join(flags + ([cat] if cat else []) + [f"{t.get('posts_count')} posts"])
              + f" | created {(t.get('created_at') or '')[:10]} | active {fmt_age(days_since(t.get('last_posted_at')))} ago")
        print(f"    {BASE}/t/{t.get('slug')}/{t.get('id')}")
        blurb = re.sub(r"\s+", " ", blurbs.get(t["id"], ""))
        if blurb:
            print(f"    > {clip(blurb, 200)}")


def topic_id(target):
    m = re.search(r"/t/(?:[^/]+/)?(\d+)", target)
    if m:
        return m.group(1)
    if target.isdigit():
        return target
    raise SystemExit("give a topic id or a devforum.roblox.com/t/... URL")


def likes(post):
    return next((a.get("count", 0) for a in post.get("actions_summary", []) if a.get("id") == 2), post.get("like_count", 0))


def cmd_read(args):
    tid = topic_id(args.target)
    d = http_json(f"{BASE}/t/{tid}.json", ttl=1800, namespace="devforum")
    posts = d.get("post_stream", {}).get("posts", [])
    if not posts:
        raise SystemExit("topic has no readable posts")
    limit = None if args.full else args.chars
    print(f"# {d.get('title')}")
    print(f"{BASE}/t/{d.get('slug')}/{tid} | {d.get('posts_count')} posts | {d.get('like_count')} likes | "
          f"created {(d.get('created_at') or '')[:10]} | views {d.get('views')}")

    def show(label, p):
        body = html_to_text(p.get("cooked"))
        if limit and len(body) > limit:
            body = body[:limit] + f"\n[... {len(body) - limit} more chars; --full]"
        print(f"\n## {label}: @{p.get('username')} #{p.get('post_number')} ({likes(p)} likes, {(p.get('created_at') or '')[:10]})")
        print(body)

    first = posts[0]
    show("question/original post", first)
    accepted = next((p for p in posts if p.get("accepted_answer")), None)
    if not accepted and (d.get("accepted_answer") or {}).get("post_number"):
        n = d["accepted_answer"]["post_number"]
        accepted = next((p for p in posts if p.get("post_number") == n), None)
        if not accepted:
            pd = http_json(f"{BASE}/posts/by_number/{tid}/{n}.json", ttl=1800, namespace="devforum")
            accepted = pd if pd.get("cooked") else None
    if accepted:
        show("ACCEPTED ANSWER", accepted)
    rest = [p for p in posts[1:] if p is not accepted and p.get("post_number") != (accepted or {}).get("post_number")]
    for p in sorted(rest, key=lambda p: -likes(p))[: args.replies]:
        show("reply", p)
    if d.get("posts_count", 0) > len(posts):
        print(f"\n({d['posts_count'] - len(posts)} later posts not loaded; open the link for the full thread)")


def main():
    ap = argparse.ArgumentParser(prog="devforum", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("search", help="search topics")
    s.add_argument("query")
    s.add_argument("-n", type=int, default=10)
    s.add_argument("--solved", action="store_true", help="only topics with an accepted answer")
    s.add_argument("--title", action="store_true", help="match words in topic titles only (less noise)")
    r = sub.add_parser("read", help="read a topic")
    r.add_argument("target", help="topic id or URL")
    r.add_argument("--replies", type=int, default=3, help="top-liked replies to show (default 3)")
    r.add_argument("--chars", type=int, default=3000, help="max chars per post (default 3000)")
    r.add_argument("--full", action="store_true", help="no per-post truncation")
    args = ap.parse_args()
    try:
        {"search": cmd_search, "read": cmd_read}[args.cmd](args)
    except HttpError as e:
        raise SystemExit(f"error: {e}")


if __name__ == "__main__":
    main()
